# 複製成 keystore.properties（已在 .gitignore，不會進 repo），填入自己的簽章資訊。
# storeFile 是相對於專案根目錄的路徑。
#
# 產生金鑰（只需一次，請妥善備份 .jks 與密碼；遺失就無法再發布同一個 App 的更新）：
#   keytool -genkeypair -v -keystore nekoyaku-release.jks -alias nekoyaku -keyalg RSA -keysize 4096 -validity 10000
#
# 也可以改用環境變數：NEKOYAKU_KEYSTORE、NEKOYAKU_KEYSTORE_PASSWORD、NEKOYAKU_KEY_ALIAS、NEKOYAKU_KEY_PASSWORD
storeFile=nekoyaku-release.jks
storePassword=
keyAlias=nekoyaku
keyPassword=
